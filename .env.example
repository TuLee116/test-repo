# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# Cơ sở dữ liệu SQLite (máy: file:./dev.db | Docker/Railway: file:/data/prod.db)
DATABASE_URL="postgresql://user:password@localhost:5432/dtcp"

# Khoá ký phiên đăng nhập. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Đặt true khi chạy sau reverse proxy / tên miền riêng
# AUTH_TRUST_HOST=true

# Thư mục lưu ảnh BOQ (mặc định: /data/uploads nếu có /data, ngược lại ./uploads)
# UPLOAD_DIR=""

# Chỉ dùng khi tạo DB trống (npm run db:seed): tài khoản admin đầu tiên, mật khẩu từ 8 ký tự
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# Chỉ đặt tạm khi quên mật khẩu admin: mỗi lần khởi động sẽ đặt lại mật khẩu → đăng nhập xong phải xoá
# ADMIN_RESET_PASSWORD=""

# Trợ lý AI (nút "Hỏi trợ lý"): khóa API Claude; để trống = ẩn trợ lý. Tuỳ chọn: AI_MODEL (mặc định claude-sonnet-5-5), AI_DAILY_LIMIT (mặc định 40 câu/người/ngày)
ANTHROPIC_API_KEY=
